# ══════════════════════════════════════════════════════════════════════════════
# Clever Relay – Git Ignore
# ══════════════════════════════════════════════════════════════════════════════

# ── Compiled Go binaries ──
/bin/
exitnode/exitnode
localengine/localengine
desktop/build/bin/
*.exe
*.dll
*.so
*.dylib
*.test
*.out

# ── Frontend build output (regenerated by `make`) ──
exitnode/dashboard/dist/
localengine/panel/dist/
desktop/frontend/dist/

# ── Node.js dependencies (regenerated by `npm install` / `bun install`) ──
node_modules/
bun.lock
package-lock.json
*.md5

# ── SQLite databases (local runtime data) ──
*.db
*.db-shm
*.db-wal

# ── Environment files (contain secrets – use .env.example as template) ──
.env
.env.local
.env.*.local

# ── Go build cache ──
vendor/

# ── IDE / Editor ──
.idea/
.vscode/
*.swp
*.swo
*~
.project
.classpath
.settings/

# ── OS files ──
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# ── Coverage & profiling ──
coverage.out
coverage.html
*.pprof
*.prof
cpu.out
mem.out

# ── Logs ──
logs/
*.log

# ── Runtime PID/logs ──
.run/
