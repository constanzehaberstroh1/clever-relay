# ══════════════════════════════════════════════════════════════════════════════
# Clever Relay – Configuration Template
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Or run: ./setup.sh  (generates .env automatically)
# ══════════════════════════════════════════════════════════════════════════════

# Pre-Shared Key (PSK) – 32 bytes, hex-encoded (64 characters)
# IMPORTANT: Must be the same on both client and exit node!
# Generate with: ./setup.sh --generate
RELAY_PSK=

# ── Exit Node (Clever Cloud) ─────────────────────────────────────────────────
PORT=8080
RELAY_PATH=/relay
ADMIN_PASSWORD=

# ── Local Client ─────────────────────────────────────────────────────────────
# Comma-separated Google Apps Script deployment URLs
GAS_URLS=

# Admin panel listen address (default: 127.0.0.1:9090)
# PANEL_ADDR=127.0.0.1:9090

# HTTP/HTTPS proxy listen address (default: :8080)
# Set to empty to disable HTTP proxy
# HTTP_PROXY_ADDR=:8080

# ── Clever Cloud Exit Node URL ───────────────────────────────────────────────
EXIT_NODE_URL=
